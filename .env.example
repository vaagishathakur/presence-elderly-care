# =====================================================================
# Presence Caregiver Dashboard - Environment Variables Example (.env.example)
# Copy this file to .env or .env.production for frontend deployment
# =====================================================================

# 1. Backend API Base URL (Deployed Express backend on Render)
VITE_API_BASE_URL=https://elderly-monitoring-backend.onrender.com/api

# 2. Amazon Cognito Configuration (for Caregiver Login)
VITE_COGNITO_USER_POOL_ID=ap-southeast-2_xoP6IPuBT
VITE_COGNITO_CLIENT_ID=2civh9uuin3idrnhe2ajil405q
VITE_AWS_REGION=ap-southeast-2

# 3. Demo Authentication Mode (disabled for production Cognito auth)
VITE_USE_DEMO_AUTH=false

# 4. Optional Voice API key for Alexa simulator
VITE_VOICE_API_KEY=voice-secret-key-presence-demo