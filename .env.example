# =====================================================================
# Presence Caregiver Dashboard - Environment Variables Example (.env.example)
# Copy this file to .env.local or .env for local dashboard development
# DO NOT commit real secrets or production credentials to git!
# =====================================================================

# 1. Backend API Base URL (Express backend runs on port 4000)
VITE_API_BASE_URL=http://localhost:4000/api

# 2. Amazon Cognito Configuration (for Caregiver Login)
# Obtain these from the AWS Cognito Console (User Pools -> App integration)
VITE_COGNITO_USER_POOL_ID=us-east-1_example
VITE_COGNITO_CLIENT_ID=exampleclientid123456789
VITE_AWS_REGION=us-east-1

# 3. Optional Local Demo Authentication Mode
# Set to true only if you want to bypass Cognito and use local demo tokens (Samridhi / Arjun)
VITE_USE_DEMO_AUTH=false